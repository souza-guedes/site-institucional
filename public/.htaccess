# ==============================================================================
# Souza Guedes Advogados - Configuração Apache/LiteSpeed (.htaccess)
# WDLC 2.1 - Rotas Amigáveis, Canonicalização e Segurança
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Bloqueio de Acesso a Arquivos Ocultos e Dotfiles (.git, .env, etc.)
    RewriteRule ^\..* - [F,L]

    # 2a. Domínio canônico sem www (WDLC 7.2): www.souzaguedes.adv.br -> souzaguedes.adv.br, já em HTTPS.
    #     Destino fixo, nunca tirado do Host, para não virar redirect aberto com www.<outro-site> (issue #31).
    RewriteCond %{HTTP_HOST} ^www\.souzaguedes\.adv\.br$ [NC]
    RewriteRule ^(.*)$ https://souzaguedes.adv.br/$1 [L,R=301]

    # 2b. Redirecionamento Canônico para HTTPS (ignora localhost e portas de desenvolvimento)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Normalização de Trailing Slash (remove barra final preservando query strings).
    #    O caminho não pode começar com /: com //outro-site/ o destino sairia //outro-site, que o
    #    navegador lê como outro domínio (issue #31).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/].*)/$ /$1 [L,R=301,QSA]

    # 4. Front Controller Pattern: Despacho de rotas para index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Bloqueio de arquivos sensíveis adicionais
<FilesMatch "(composer\.(json|lock)|\.env|\.git|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>

# Headers de Segurança
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Não expõe a versão do PHP (issue #31); public/index.php também remove o cabeçalho
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HSTS (WDLC 7.2): só em respostas HTTPS; sem preload, para não prender o domínio à lista dos navegadores
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Compressão e cache (WDLC 6.1)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Imagens mantêm o nome quando trocadas: 30 dias. Fontes não mudam de conteúdo: 1 ano.
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    # CSS e JS levam ?v=<data de modificação> no link (asset() em src/Views/helpers.php)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp

# Desativação de listagem de diretórios
Options -Indexes
