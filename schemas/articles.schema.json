{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SouzaGuedesArticles",
  "description": "Schema dos artigos informativos de Artigos e Informações (WDLC 4.1). Conteúdo educativo nos termos do Art. 4º do Provimento CFOAB nº 205/2021.",
  "type": "object",
  "required": ["version", "last_updated", "educational_notice", "articles"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date" },
    "educational_notice": { "type": "string", "minLength": 40 },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "area_slug",
          "author",
          "excerpt",
          "reading_time_minutes",
          "word_count",
          "sections",
          "references",
          "status",
          "published_at",
          "updated_at",
          "pending"
        ],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "area_slug": {
            "description": "Slug de uma das áreas de atuação de data/firm-profile.json.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "author": {
            "description": "Nome completo de um dos sócios de data/firm-profile.json.",
            "type": "string"
          },
          "excerpt": { "type": "string" },
          "reading_time_minutes": { "type": "integer", "minimum": 1 },
          "word_count": { "type": "integer", "minimum": 1 },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["heading", "paragraphs", "list", "closing_paragraphs"],
              "properties": {
                "heading": { "type": "string" },
                "paragraphs": { "type": "array", "items": { "type": "string" } },
                "list": { "type": "array", "items": { "type": "string" } },
                "closing_paragraphs": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "references": {
            "description": "Normas e decisões citadas, para conferência.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "status": { "type": "string", "enum": ["rascunho", "aprovado"] },
          "published_at": { "type": ["string", "null"], "format": "date" },
          "updated_at": { "type": "string", "format": "date" },
          "pending": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
